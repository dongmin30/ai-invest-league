# AI Invest League 환경 변수 예시
# 이 파일을 .env 로 복사해서 사용하세요 (cp .env.example .env). 모든 값은 선택 사항입니다.
# .env 는 절대 커밋하지 마세요.

# ── 서버 ─────────────────────────────────────────────
# 서버 포트 (Vite 개발 서버는 5173 에서 /api 를 이 포트로 프록시)
PORT=8787

# 로그인 쿠키(JWT) 서명 키. 비워두면 부팅할 때마다 무작위 값이 생성되어 재시작 시 로그아웃됩니다(경고 출력).
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 관리자 이메일 (쉼표로 구분). 비워두면 첫 번째로 가입한 사용자가 관리자가 됩니다.
# 다른 사람이 접속할 수 있는 곳에 서버를 띄우기 전에 반드시 설정하세요.
ADMIN_EMAILS=

# HTTPS 로 서비스할 때 true: 로그인 쿠키에 Secure 속성을 붙입니다 (기본값: NODE_ENV=production 이면 true)
COOKIE_SECURE=

# 리버스 프록시(nginx 등) 뒤에서 실행할 때 true: X-Forwarded-For 로 클라이언트 IP 를 판별해 요청 제한에 사용
TRUST_PROXY=false

# SQLite DB 와 KIS 토큰 캐시를 둘 폴더 (기본값: server/data, 상대 경로는 저장소 루트 기준).
# 개발 DB 를 건드리지 않고 시험 부팅할 때 사용: DATA_DIR=server/data/smoke npm start
# (.env 값이 셸 변수보다 우선하므로, 셸에서 지정하려면 .env 에 DATA_DIR/PORT 를 넣지 마세요)
# DATA_DIR=

# ── 시세 ─────────────────────────────────────────────
# yahoo : 키 없이 사용 가능한 Yahoo Finance 차트 JSON (지연 시세일 수 있음, 기본값)
# kis   : 한국투자증권 Open API (아래 KIS 키 필요)
# sim   : 오프라인 랜덤워크 시세 (인터넷/키 없이 데모용)
PRICE_PROVIDER=yahoo

# true 면 국내/해외 시장을 항상 개장 상태로 취급 (주말·야간 데모용, PRICE_PROVIDER=sim 과 함께 사용)
SIM_ALWAYS_OPEN=false

# 시세 수집 주기(초)
COLLECT_INTERVAL_SEC=60

# 한국투자증권 Open API (실전계좌 앱키, 시세 조회 전용). PRICE_PROVIDER=kis 일 때만 필요
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# ── AI 에이전트 ──────────────────────────────────────
# 설정하면 'Claude 트레이더' 에이전트가 활성화됩니다. Max 플랜의 월간 API 크레딧으로 충전된 Console 키를 사용하세요.
# claude.ai 구독 OAuth 토큰은 서버에 넣지 마세요.
ANTHROPIC_API_KEY=

# Claude 에이전트 모델과 effort (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# 로컬 LLM (Ollama). 예: http://localhost:11434 — 부팅 시 접속 가능하면 '로컬 LLM 트레이더'가 활성화됩니다.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:8b

# 에이전트 1회 의사결정 제한 시간(초). 초과 시 HOLD 로 기록
AGENT_TIMEOUT_SEC=60
