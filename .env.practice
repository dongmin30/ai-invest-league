# 연습 모드 설정 (npm run practice 가 ENV_OVERLAY=.env.practice 로 불러옵니다)
# .env 를 먼저 읽은 뒤 이 파일의 값이 덮어씁니다. 여기에 없는 값(JWT_SECRET, OLLAMA_* 등)은 .env 값을 그대로 씁니다.
# 비밀 값은 넣지 마세요. 이 파일은 커밋됩니다.

# 가상 시세: 마지막으로 저장된 시세(없으면 내장 기준가)에서 시작하는 랜덤워크
PRICE_PROVIDER=sim

# 주말·야간에도 국내/해외 시장을 항상 개장 상태로 취급 (공식 리그가 바로 시작됨)
SIM_ALWAYS_OPEN=true

# 시세 수집·체결 주기(초). 연습용으로 짧게
COLLECT_INTERVAL_SEC=10

# 실제 DB(server/data/app.db)를 건드리지 않도록 별도 폴더 사용. 언제든 지워도 됩니다.
DATA_DIR=server/data/practice

# 연습 모드에서는 Claude 에이전트를 끕니다 (API 크레딧 절약).
# 켜려면 아래 ANTHROPIC_API_KEY= 줄을 지우고 재시작하세요. 그러면 .env 의 키를 사용합니다 (여기에 키를 넣지 마세요).
# 대략적인 비용: claude-opus-5-5 기준 판단 1회 약 $0.03~0.06, 상시 개장이라 공식 리그 9개(KR/US/통합 × 3일/1주/1개월)에서
# 하루 약 200회 판단 → 하루 약 $6~12 정도 듭니다. 리그의 판단 주기를 길게 두면 줄어듭니다.
ANTHROPIC_API_KEY=
